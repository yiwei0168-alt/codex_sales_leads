{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-e2e-blind-judge-output-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["packetId", "externalSearchUsed", "externalKnowledgeUsed", "isRealOperatingCompany", "operatesInTargetMarket", "supportedRoles", "primaryRole", "dimensions", "totalScore", "eligibility", "dimensionReasons", "unsupportedOrContradictoryClaims"],
  "properties": {
    "packetId": { "type": "string", "minLength": 8, "maxLength": 100 },
    "externalSearchUsed": { "type": "boolean" },
    "externalKnowledgeUsed": { "type": "boolean" },
    "isRealOperatingCompany": { "type": "boolean" },
    "operatesInTargetMarket": { "type": "boolean" },
    "supportedRoles": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 80 } },
    "primaryRole": { "type": "string", "maxLength": 80 },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productAndUseCaseFit", "channelAndBuyingInfluence", "sameRoleScaleAndCoverage", "executionAndEnablement", "opportunityAndRisk"],
      "properties": {
        "productAndUseCaseFit": { "type": "integer", "minimum": 0, "maximum": 50 },
        "channelAndBuyingInfluence": { "type": "integer", "minimum": 0, "maximum": 15 },
        "sameRoleScaleAndCoverage": { "type": "integer", "minimum": 0, "maximum": 15 },
        "executionAndEnablement": { "type": "integer", "minimum": 0, "maximum": 10 },
        "opportunityAndRisk": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "totalScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "eligibility": { "type": "string", "enum": ["eligible", "research-required", "ineligible-for-current-task", "insufficient-evidence-for-recommendation"] },
    "dimensionReasons": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "reason", "citations"],
        "properties": {
          "dimension": { "type": "string", "enum": ["productAndUseCaseFit", "channelAndBuyingInfluence", "sameRoleScaleAndCoverage", "executionAndEnablement", "opportunityAndRisk"] },
          "reason": { "type": "string", "maxLength": 500 },
          "citations": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidenceId", "claim", "support"],
              "properties": {
                "evidenceId": { "type": "string", "minLength": 1, "maxLength": 100 },
                "claim": { "type": "string", "minLength": 1, "maxLength": 500 },
                "support": { "type": "string", "enum": ["direct", "partial", "context-only", "unsupported"] }
              }
            }
          }
        }
      }
    },
    "unsupportedOrContradictoryClaims": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 500 } }
  }
}
