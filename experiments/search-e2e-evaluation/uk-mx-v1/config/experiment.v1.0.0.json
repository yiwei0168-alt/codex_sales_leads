  "blindAudit": {
    "primaryModel": "claude-opus-5",
    "preflightOnlyFallbackModel": "claude-opus-4-8",
    "allowWebSearch": false,
    "initialSample": 32,
    "expandedSample": 64,
    "maximumSample": 64,
    "primaryRoleAgreementMinimum": 0.95,
    "qualifiedStatusAgreementMinimum": 0.90,
