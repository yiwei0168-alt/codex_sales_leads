{
  "experimentId": "search-e2e-eval-v1.0.11",
  "runId": "2026-09-02-uk-mx-search-e2e-v1-11",
  "status": "preregistered-pending-preflight",
  "objective": "Compare the current cold-start product end-to-end company-search workflow with an un-tuned Gemini Full baseline.",
  "arms": {
