  "bootstrap": { "iterations": 10000, "confidenceLevel": 0.95, "stratifyByCell": true, "seed": 20260902 },
  "executionOrder": [
    { "sequence": 1, "cellId": "MX-retail", "countryCode": "MX", "categoryId": "retail", "armStartOrder": ["gemini-native", "product-e2e"] },
    { "sequence": 2, "cellId": "GB-distribution", "countryCode": "GB", "categoryId": "distribution", "armStartOrder": ["product-e2e", "gemini-native"] },
    { "sequence": 3, "cellId": "MX-si-msp", "countryCode": "MX", "categoryId": "si-msp", "armStartOrder": ["gemini-native", "product-e2e"] },
    { "sequence": 4, "cellId": "GB-resale", "countryCode": "GB", "categoryId": "resale", "armStartOrder": ["product-e2e", "gemini-native"] },
    { "sequence": 5, "cellId": "MX-distribution", "countryCode": "MX", "categoryId": "distribution", "armStartOrder": ["gemini-native", "product-e2e"] },
    { "sequence": 6, "cellId": "GB-retail", "countryCode": "GB", "categoryId": "retail", "armStartOrder": ["product-e2e", "gemini-native"] },
    { "sequence": 7, "cellId": "MX-resale", "countryCode": "MX", "categoryId": "resale", "armStartOrder": ["gemini-native", "product-e2e"] },
    { "sequence": 8, "cellId": "GB-si-msp", "countryCode": "GB", "categoryId": "si-msp", "armStartOrder": ["product-e2e", "gemini-native"] }
  ],
  "winGate": {
