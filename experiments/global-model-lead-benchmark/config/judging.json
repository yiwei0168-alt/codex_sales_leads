{
  "schemaVersion": 3,
  "status": "confirmed",
  "primaryCompanyCutoff": 40,
  "categoryCutoff": 10,
  "categories": ["tier1_distributor", "reseller", "retailer", "si"],
  "objective": "identify and rank the highest-fit potential Cudy companies in four fixed channel categories; current Cudy relationship has zero scoring weight",
  "eligibilityGates": [
    "submittedIdentityUsable",
    "companyExists",
    "targetCountryPresence",
    "relevantChannel",
    "sufficientEvidence",
    "independentProspect"
  ],
  "potentialFitDimensions": {
    "channelRoleAndCustomerAccess": 30,
    "productAndUseCaseFit": 25,
    "targetMarketCoverage": 20,
    "partnershipExecutionCapability": 15,
    "strategicComplementarity": 10
  },
  "categoryMismatchPolicy": {
    "candidateRemainsEligible": true,
    "channelRoleAndCustomerAccessPointDeduction": {
      "exact_or_primary_role": 0,
      "credible_secondary_role": 3,
      "material_mismatch_within_the_four_categories": 8
    },
    "additionalProductAndUseCaseFitDeductionWhenMismatchWeakensUseCaseFit": [0, 5],
    "floorEachDimensionAtZero": true,
    "scoringTreatment": "apply the category-alignment deduction after scoring the underlying company fit; do not fail an eligibility gate solely because the submitted category is inaccurate",
    "metricsBucket": "score the candidate in the category where the submitting system placed it"
  },
  "potentialFitBands": {
    "high_fit": [80, 100],
    "strong_fit": [65, 79],
    "follow_up": [50, 64],
    "unqualified": [0, 49]
  },
  "qualifiedPotentialFitThreshold": 50,
  "relationshipStatusPolicy": {
    "scoringWeight": 0,
    "values": ["confirmed_existing", "no_public_evidence", "unknown"],
    "confirmedExistingDisposition": "exclude_from_net_new_primary_pool_and_report_separately"
  },
  "contactScoring": null,
  "primaryMetrics": [
    "MacroPotentialFitNDCG@10ByCategory",
    "MacroMeanPotentialFit@10ByCategory",
    "MacroPrecision@10ByCategory",
    "QualifiedProspects@40",
    "CategoryQuotaCompletionRate",
    "PooledRecall"
  ],
  "secondaryMetrics": [
    "confirmedExistingRelationshipCount",
    "uniqueQualifiedNetNewProspectCount",
    "sourceSupportedRate",
    "officialSourceRate",
    "latencyMs",
    "searchRequestsObserved"
  ],
  "resourceEfficiencyMetrics": [
    "qualifiedProspectsPerObservedSearchRequest",
    "qualifiedProspectsPerMinute",
    "estimatedCostPerQualifiedProspect"
  ],
  "humanInTheLoop": {
    "reviewers": 1,
    "finalReviewer": "user",
    "providerIdentityHidden": true,
    "codexReviewsAllPooledTop40Candidates": true,
    "blindHumanAuditPercent": 25,
    "blindHumanAuditMinimum": 12,
    "companyAssessmentOnly": true,
    "contactsAuditedByCodexSeparately": false,
    "auditHighRiskCandidates": true,
    "highRiskSupplementMaximumPercent": 10,
    "failedAuditExpansionPercent": 15,
    "auditSeed": "CUDY-FOUR-CHANNEL-V4-HUMAN-AUDIT",
    "acceptanceThresholds": {
      "qualifiedStatusAgreement": 0.9,
      "fitBandExactAgreement": 0.8,
      "weightedKappa": 0.75,
      "potentialFitMeanAbsoluteErrorMaximum": 10
    }
  },
  "invalidReasons": [
    "industry_mismatch",
    "country_mismatch",
    "insufficient_evidence",
    "duplicate",
    "not_a_company",
    "not_independent_sales_lead"
  ],
  "goldPoolPolicy": {
    "source": "deduplicated union of every measured model-run and product-comparator run's top-10 candidates in each of four categories",
    "primaryPool": "gate-valid candidates without a publicly confirmed existing Cudy relationship and with potentialFitScore >= 50",
    "existingRelationshipHandling": "metadata-only reference pool; never a fit-score bonus",
    "projectCrmExcluded": true,
    "historicalLeadDatabaseExcluded": true,
    "codexMayUsePublicWebForPostRunVerification": true,
    "verificationEvidenceNeverReturnedToTestedModels": true
  }
}
