# Channel snapshot works without credentials. RAG requires PostgreSQL,
# an OpenAI-compatible embedding provider, and a generation provider.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/network_copilot
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_GENERATION_MODEL=gpt-5-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1536
RAG_MIN_SCORE=0.35
RAG_MAX_CONTEXT_CHUNKS=8
KNOWLEDGE_ADMIN_TOKEN=change-me-for-non-local-deployments

# Legacy owner bootstrap authentication. New users are stored in PostgreSQL and
# created with `npm run users:upsert`; set setup values only for that shell session.
APP_PASSWORD_HASH=
MAILBOX_CREDENTIAL_KEY=

# Tavily search provider for the Mexico pilot.
TAVILY_API_KEY=
TAVILY_REQUEST_TIMEOUT_MS=30000

# Contact-verification evidence assessment. Outbound verification remains disabled.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ESCALATION_MODEL=deepseek-v4-pro
CONTACT_VERIFICATION_TIMEOUT_MS=30000
