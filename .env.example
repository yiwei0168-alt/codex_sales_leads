# Channel snapshot works without credentials. RAG requires PostgreSQL + OpenAI.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/network_copilot
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-5-mini
RAG_MIN_SCORE=0.35
RAG_MAX_CONTEXT_CHUNKS=8
KNOWLEDGE_ADMIN_TOKEN=change-me-for-non-local-deployments

# Optional future discovery provider.
SEARCH_PROVIDER_API_KEY=
