# Channel snapshot works without credentials. RAG requires PostgreSQL,
# an OpenAI-compatible embedding provider, and a generation provider.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/network_copilot
# Use a separate owner/migrator credential only for `npm run db:migrate`.
# It must use the same host/port/database as DATABASE_URL; only the login differs.
# The application must continue using the restricted DATABASE_URL above.
DATABASE_MIGRATION_URL=
# Remote production databases must use sslmode=require (or stricter), a trusted CA,
# and a dedicated login role without SUPERUSER/BYPASSRLS.
DATABASE_SSL_CA=
# Use a mounted PEM bundle instead of DATABASE_SSL_CA when the chain is too
# large for an environment variable. Keep deployment-specific paths out of Git.
DATABASE_SSL_CA_FILE=
DATABASE_APPLICATION_ROLE=network_copilot_app
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_GENERATION_MODEL=gpt-5-mini
# LangChain Market Playbook planner. The main product uses Lingyu by default.
LEAD_PLANNER_API_KEY=
LEAD_PLANNER_BASE_URL=https://lingyuapi.com/v1
LEAD_PLANNER_MODEL=gpt-5-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1536
RAG_MIN_SCORE=0.35
RAG_MAX_CONTEXT_CHUNKS=8
KNOWLEDGE_ADMIN_TOKEN=change-me-for-non-local-deployments

# Aggregation-gateway credentials used only by the native-search benchmark.
# Keep real values in .env.local. OpenAI and Claude use separate keys.
LINGYU_API_KEY=
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://lingyuapi.com
CLAUDE_API_VERSION=2023-06-01
CLAUDE_OUTREACH_MODEL=claude-sonnet-4-6
CLAUDE_OUTREACH_MAX_TOKENS=4000
CLAUDE_OUTREACH_TEMPERATURE=0.4
CLAUDE_OUTREACH_TIMEOUT_MS=240000

# Legacy owner bootstrap authentication. New users are stored in PostgreSQL and
# created with `npm run users:upsert`; set setup values only for that shell session.
APP_PASSWORD_HASH=
MAILBOX_CREDENTIAL_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
KIMI_INTENT_MODEL=kimi-k3
KIMI_INTENT_TIMEOUT_MS=45000
KIMI_OUTREACH_MODEL=kimi-k3
# The current kimi-k3 endpoint accepts temperature=1 for this workflow.
KIMI_OUTREACH_TEMPERATURE=1
KIMI_OUTREACH_MAX_TOKENS=12000
KIMI_OUTREACH_TIMEOUT_MS=180000
MAILBOX_RAW_RETENTION_DAYS=365

# Tavily is invoked only after the user confirms a generated country search plan.
TAVILY_API_KEY=
TAVILY_REQUEST_TIMEOUT_MS=30000

# `inline` works without a separate compute service. Switch to `worker` only
# after deploying `npm run leads:worker` on ECS or another persistent Node host.
LEAD_WORKFLOW_EXECUTION_MODE=inline
LEAD_WORKFLOW_WORKER_POLL_MS=3000

# Contact-verification evidence assessment. Outbound verification remains disabled.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ESCALATION_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
# Leave empty for automatic routing: Flash uses chat/completions; Pro uses the
# official Anthropic-compatible endpoint validated by the benchmark.
DEEPSEEK_TRANSPORT=

# xAI Grok benchmark provider (keep real credentials in .env.local only)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Google Gemini benchmark provider. The adapter also accepts the official
# OpenAI-compatible /v1beta/openai base and derives the native Interactions URL.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_SEARCH_MODEL=gemini-3.6-flash
GEMINI_SEARCH_TIMEOUT_MS=90000

CONTACT_VERIFICATION_TIMEOUT_MS=30000
CONTACT_VERIFICATION_MODE=automatic

# Optional post-qualification contact lookup. It is deliberately separate from
# company fit scoring and disabled until the user configures a provider.
CONTACT_LOOKUP_ENABLED=false
CONTACT_LOOKUP_PROVIDER=snov
SNOV_USER_ID=
SNOV_API_SECRET=
