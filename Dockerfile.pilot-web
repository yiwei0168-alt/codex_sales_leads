FROM node:24-bookworm-slim AS builder
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
COPY --from=builder --chown=node:node /build/.next/standalone ./
COPY --from=builder --chown=node:node /build/.next/static ./.next/static
COPY --from=builder --chown=node:node /build/scripts/start-ma24-pilot-container.mjs /opt/pilot/start.mjs
RUN mkdir -p /app/knowledge/uploads && chown -R node:node /app/knowledge
USER node
EXPOSE 3000
CMD ["node", "/opt/pilot/start.mjs", "/app"]
