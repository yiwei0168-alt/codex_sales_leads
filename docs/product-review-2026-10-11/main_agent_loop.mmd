%%{init: {'flowchart': {'curve': 'linear'}}}%%
graph TD;
	__start__([<p>__start__</p>]):::first
	safe_boundary(safe_boundary)
	main_model(main_model)
	execute_tool(execute_tool)
	__end__([<p>__end__</p>]):::last
	__start__ --> safe_boundary;
	safe_boundary -.-> main_model;
	safe_boundary -.-> execute_tool;
	safe_boundary -.-> __end__;
	main_model -.-> safe_boundary;
	main_model -.-> execute_tool;
	main_model -.-> __end__;
	execute_tool -.-> safe_boundary;
	execute_tool -.-> main_model;
	execute_tool -.-> __end__;
	classDef default fill:#f2f0ff,line-height:1.2;
	classDef first fill-opacity:0;
	classDef last fill:#bfb6fc;
